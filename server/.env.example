NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas → Network Access must allow 0.0.0.0/0 for Vercel serverless deployments,
# because Vercel's egress IPs are dynamic.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+923000000000
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-session-secret-to-at-least-16-characters

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
